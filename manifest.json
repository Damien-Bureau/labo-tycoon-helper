{
  "manifest_version": 3,
  "name": "Labo Tycoon Helper",
  "version": "1.21.0",
  "description": "Affiche à droite de chaque bâtiment de l'onglet Labo le ratio prix ÷ production (coloré du meilleur au pire achat), la hausse de production en % et le rapport prix d’un bit/s ÷ hausse %.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Labo Tycoon Helper",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sector-production-b749.up.railway.app/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "labo-tycoon-helper@damien-bureau",
      "strict_min_version": "109.0"
    }
  }
}
